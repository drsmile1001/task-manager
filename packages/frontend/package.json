{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite",
    "build": "bun run typecheck && bunx --bun vite build",
    "preview": "bunx --bun vite preview",
    "format": "bunx prettier . --write",
    "typecheck": "bun run --cwd ../backend typegen && bunx tsc -p tsconfig.app.json --noEmit && bunx tsc -p tsconfig.node.json --noEmit && bunx tsc -p tsconfig.test.json --noEmit",
    "test": "bun test test",
    "test:watch": "bun test --watch test"
  },
  "dependencies": {
    "@elysiajs/eden": "^1.4.8",
    "@tailwindcss/vite": "^4.2.1",
    "date-fns": "^4.1.0",
    "ky": "^1.14.3",
    "lodash": "^4.17.23",
    "marked": "^17.0.3",
    "solid-js": "^1.9.11",
    "tailwindcss": "^4.2.1",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.3.2",
    "bun-types": "^1.3.10",
    "prettier": "^3.8.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-solid": "^2.11.10"
  }
}
